{
  "name": "klankern",
  "version": "1.13.2",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "typecheck": "nuxt typecheck && npm run typecheck:tests",
    "typecheck:tests": "vue-tsc --noEmit -p tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nuxt prepare && vitest run",
    "test:watch": "nuxt prepare && vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@catppuccin/palette": "1.8.0",
    "@nuxtjs/supabase": "2.0.10",
    "@pinia/nuxt": "1.0.2",
    "@quasar/extras": "2.1.0",
    "nuxt": "4.6.0",
    "nuxt-quasar-ui": "3.1.2",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "1.64.0",
    "@vite-pwa/nuxt": "1.1.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "dotenv": "18.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "netlify-cli": "27.12.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-empty": [
        2,
        "never"
      ]
    }
  },
  "packageManager": "npm@11.19.0+sha512.48377f8478372aa1c4e47b763475b135836da82436a5700f2e5e8eb5084fc840f93c7b117eb3ad3b5f7d3194c81b6710a10d59448f6ddbcb21ac3fb672bdc003",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "netlify-cli@27.12.0": true,
    "sharp@0.34.5": true,
    "unix-dgram@2.0.7": true,
    "unrs-resolver@1.12.2": true
  }
}
